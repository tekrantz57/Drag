<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\drag.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DragWin</RootNamespace>
    <Version>0.5.0-beta.1</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.05.0-beta.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DisplayVersion>v0.05.0-beta.1</DisplayVersion>
    <!-- SQLite 7 lists Alpine RIDs that are irrelevant to this Windows-only app. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="dragWin.ProtocolTests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\dragMC\dist\*.dragfw">
      <Link>Firmware\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\tools\drag-speech-helper.py">
      <Link>Linux\drag-speech-helper.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RequireControllerFirmwarePackage" BeforeTargets="Publish">
    <PropertyGroup>
      <_DragMcVersionHeader>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\dragMC\FirmwareVersion.h'))</_DragMcVersionHeader>
      <_DragMcFirmwareVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_DragMcVersionHeader)', 'DRAGMC_FIRMWARE_VERSION\s+&quot;([^&quot;]+)&quot;').Groups[1].Value)</_DragMcFirmwareVersion>
      <_ExpectedFirmwarePackage>$(MSBuildProjectDirectory)\..\dragMC\dist\DragMC-mega-$(_DragMcFirmwareVersion).dragfw</_ExpectedFirmwarePackage>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(_ExpectedFirmwarePackage)')"
      Text="Build DragMC $(_DragMcFirmwareVersion) with tools\Build-ControllerFirmware.ps1 before publishing DragWin." />
  </Target>

  <Target Name="AddGitBuildDescription" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <GitBuildDescription>$(DisplayVersion)</GitBuildDescription>
      <GitBuildDescription Condition="'$(GitBuildDescriptionOverride)' != ''">$(GitBuildDescriptionOverride)</GitBuildDescription>
    </PropertyGroup>
    <Exec
      Command="git describe --tags --always --long --dirty"
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      StandardOutputImportance="Low"
      WorkingDirectory="$(MSBuildProjectDirectory)\.."
      Condition="Exists('$(MSBuildProjectDirectory)\..\.git') and '$(GitBuildDescriptionOverride)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitBuildDescription" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="GitBuildDescription" Value="$(GitBuildDescription)" />
    </ItemGroup>
  </Target>
</Project>
